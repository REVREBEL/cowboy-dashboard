
---
import MainLayout from '../layouts/main.astro';
import { baseUrl } from '../lib/base-url';
---

<MainLayout pageClass="home">
  <div class="min-h-screen bg-background flex items-center justify-center">
    <div class="text-center">
      <h1 class="font-heading text-4xl mb-4 text-foreground">CMS Portal</h1>
      <p class="text-muted-foreground font-body mb-8">Loading portal...</p>
      <a href={`${baseUrl}/portal`} class="inline-block px-6 py-3 bg-primary text-primary-foreground font-button rounded hover:bg-primary/90 transition-colors">
        Go to Portal
      </a>
    </div>
  </div>
  
  <script is:inline define:vars={{ baseUrl }}>
    // Client-side redirect after a brief moment
    setTimeout(() => {
      window.location.href = `${baseUrl}/portal`;
    }, 100);
  </script>
</MainLayout>



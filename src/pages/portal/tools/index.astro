
---
import MainLayout from '../../../layouts/main.astro';
import { baseUrl } from '../../../lib/base-url';
import AltTextManagerClient from '../../../components/tools/AltTextManagerClient';
import SyncRoomPhotos from '../../../components/SyncRoomPhotos';
---

<MainLayout pageClass="portal-tools">
  <div class="min-h-screen bg-background">
    <!-- Header -->
    <header class="border-b border-border bg-muted">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-8">
        <a
          href={`${baseUrl}/portal`}
          class="inline-flex items-center gap-2 text-sm font-body text-muted-foreground hover:text-foreground transition-colors mb-4"
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" class="flex-shrink-0">
            <path d="M6 3L2 8l4 5M2 8h12" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>Portal</span>
        </a>
        <h1 class="font-heading text-2xl sm:text-3xl mb-2 text-foreground">
          Tools
        </h1>
        <p class="text-sm font-body text-muted-foreground">
          Utilities for auditing and bulk-managing your CMS content
        </p>
      </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-10">
      <section>
        <p class="text-xs font-button uppercase tracking-wider text-muted-foreground mb-3">
          Mews integration
        </p>
        <SyncRoomPhotos client:only="react" />
      </section>

      <section>
        <p class="text-xs font-button uppercase tracking-wider text-muted-foreground mb-3">
          Alt text manager
        </p>
        <AltTextManagerClient client:only="react" />
      </section>
    </main>
  </div>
</MainLayout>



